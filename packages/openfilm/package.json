{
  "name": "openfilm",
  "version": "0.4.1",
  "description": "Fillim / OpenFilm Studio: cloud AI film & video editor with Neon Postgres, Neon Auth, deterministic window.film shots, and multi-track NLE workbenches.",
  "license": "MIT",
  "homepage": "https://fillim.campusloop.space",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/playlikemen/fillim.git",
    "directory": "packages/openfilm"
  },
  "bugs": {
    "url": "https://github.com/playlikemen/fillim/issues"
  },
  "keywords": [
    "video",
    "motion-graphics",
    "agents",
    "claude-code",
    "codex",
    "animation",
    "render"
  ],
  "type": "module",
  "bin": {
    "openfilm": "bin/openfilm.mjs"
  },
  "exports": {
    "./film-doc": "./src/film-doc.mjs",
    "./host": "./src/host.mjs",
    "./shared": "./src/shared.mjs",
    "./look": "./src/look.mjs",
    "./render": "./src/render.mjs",
    "./problems": "./src/problems.mjs",
    "./plugins": "./src/plugins.mjs",
    "./skills": "./src/skills.mjs",
    "./skills-cli": "./src/skills-cli.mjs",
    "./system-prompt": "./src/system-prompt.mjs",
    "./studio": "./studio/server/server.mjs",
    "./desktop-account": "./studio/server/account.mjs",
    "./studio-ui/*": "./studio/ui/src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "SPEC.md",
    "TRADEMARK.md",
    "bin",
    "manual",
    "plugins",
    "!plugins/**/*.test.mjs",
    "!plugins/*/test",
    "library",
    "!library/voices",
    "!library/audio",
    "!library/stickers/emoji",
    "!library/models",
    "!library/examples",
    "!library/vectors.i8",
    "!library/vectors.json",
    "examples-index",
    "skill-catalog-seed.json",
    "models/vision",
    "src",
    "!src/**/*.test.mjs",
    "!src/color/fixtures",
    "SYSTEM_PROMPT.md",
    "studio/server/**/*.mjs",
    "studio/server/**/*.js",
    "!studio/server/**/*.test.mjs",
    "studio/client.mjs",
    "studio/ui/dist",
    "THIRD_PARTY_NOTICES.md",
    "product.json"
  ],
  "engines": {
    "node": ">=22.2"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.2.2",
    "@neondatabase/auth": "0.7.0-beta",
    "@neondatabase/serverless": "1.2.1",
    "jose": "6.2.18",
    "onnxruntime-web": "1.31.1",
    "pg": "8.23.1",
    "playwright-core": "1.61.1"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "test": "node --test --test-concurrency=1 --test-timeout=600000 src/*.test.mjs src/color/*.test.mjs scripts/*.test.mjs studio/*.test.mjs studio/server/*.test.mjs studio/server/providers/*.test.mjs plugins/*/*.test.mjs plugins/*/test/*.test.mjs studio/ui/src/editor/*.test.ts studio/ui/src/lib/*.test.ts studio/ui/src/components/*.test.ts",
    "typecheck": "tsc -p studio/server && tsc -p studio/ui",
    "build:ui": "vite build --config studio/ui/vite.config.ts",
    "prepare": "npm run build:ui",
    "prepack": "node scripts/product.mjs official",
    "postpack": "node scripts/product.mjs restore"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-heading": "3.32.0",
    "@tiptap/extension-list": "3.32.0",
    "@tiptap/extension-paragraph": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/extension-text-align": "3.32.0",
    "@tiptap/extension-underline": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/markdown": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@types/node": "^22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@xyflow/react": "^12.12.0",
    "lucide-react": "^0.469.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
