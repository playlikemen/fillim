{
  "name": "fillim",
  "private": true,
  "description": "Fillim — Cloud AI Film Studio & SaaS built on OpenFilm, powered by Neon Lakebase Postgres and Neon Auth.",
  "homepage": "https://fillim.campusloop.space",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/playlikemen/fillim.git"
  },
  "bugs": {
    "url": "https://github.com/playlikemen/fillim/issues"
  },
  "keywords": [
    "fillim",
    "openfilm",
    "ai-video",
    "video-editor",
    "motion-graphics",
    "neon",
    "saas"
  ],
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "pnpm --filter openfilm dev",
    "dev:desktop": "pnpm --filter @openfilm/desktop start",
    "build": "pnpm --filter openfilm build:ui && pnpm --filter @openfilm/desktop build:shell",
    "test": "pnpm -r --workspace-concurrency=1 --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "audit:public": "node scripts/audit-public.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "changeset": "changeset",
    "examples:sync": "node scripts/sync-examples.mjs"
  },
  "devDependencies": {
    "@changesets/changelog-github": "0.5.2",
    "@changesets/cli": "2.31.1",
    "@neon/config": "1.14.7"
  },
  "pnpm": {
    "overrides": {
      "zod@>=4 <4.6.6": "^4.6.6",
      "undici@>=8 <8.12.2": "^8.12.2",
      "minimatch@>=7 <11.0.1": "^11.0.1"
    }
  }
}
